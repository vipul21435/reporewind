"""Turn titles into URL slugs."""

import re

_UNSAFE = re.compile(r"[^a-z0-9]+")


def slugify(title, sep="-"):
    """Lowercase ``title``; collapse each run of unsafe characters into one ``sep``."""
    return _UNSAFE.sub(sep, title.lower()).strip(sep)

