"""Turn titles into URL slugs."""

import re

_UNSAFE = re.compile(r"[^a-z0-9]")


def slugify(title, sep="-"):
    """Lowercase ``title`` and replace every unsafe character with ``sep``."""
    return _UNSAFE.sub(sep, title.strip().lower())

