# Copy to .env and fill in only what you need. Nothing here is required for
# the offline test suite.

# GitHub token used to resolve PR numbers to fix commits (optional; the
# unauthenticated API works but is rate limited to 60 requests/hour).
GITHUB_TOKEN=

# Where RepoRewind keeps clones, the build cache index and lock files.
REPOREWIND_HOME=.reporewind

# Set to 1 to skip `docker buildx imagetools inspect` and use the offline
# base-image digest table instead.
REPOREWIND_OFFLINE=0
